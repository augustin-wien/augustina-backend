# Building the binary of the App
FROM golang:alpine AS build

WORKDIR /go/src/augustin

RUN go install github.com/jackc/tern/v2@latest

# Downloads all the dependencies in advance, so they stay cached while the code changes
COPY ./app/go.mod ./app/go.sum ./
RUN go mod download

COPY ./app .

# Builds the application as a staticly linked one, to allow it to run on alpine
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -trimpath -o app .

# The final image only gets the binary and the files the app reads at runtime,
# no source code, tests or local files
FROM alpine:latest AS release

WORKDIR /app
# Add packages
RUN apk -U upgrade \
    && apk add --no-cache dumb-init ca-certificates
COPY --from=build /go/bin/tern /tern
COPY --from=build /go/src/augustin/app /app/app

COPY ./app/migrations/ /app/migrations/
COPY ./app/templates/ /app/templates/
COPY ./app/public/ /app/public/
COPY ./app/img/demo_* /app/img/
RUN mkdir -p /app/pdf

COPY ./docker/entrypoint.sh /
RUN chmod +x /app/app /entrypoint.sh

# Exposes port 3000 because our program listens on that port
EXPOSE 3000

ENTRYPOINT ["/entrypoint.sh"]
